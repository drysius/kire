@component("layout", { title: "Counter — h3 + Kire" })
	@section("content")
		<section class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
			<h1 class="text-2xl font-bold">Reactive counter</h1>
			<p class="mt-2 text-slate-600">
				Server-driven reactivity with Kirewire. Each click posts to the server
				and the DOM is morphed in place — no custom client code.
			</p>

			<div class="mt-6 rounded-xl bg-slate-50 p-6 ring-1 ring-slate-200">
				@wire("counter")
			</div>
		</section>

		{{-- Injects the Kirewire client runtime (served at /kirewire.js). --}}
		@kirewireScripts
	@endsection
@endcomponent
