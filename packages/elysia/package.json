{
	"name": "@kirejs/elysia",
	"description": "Elysia integration for Kire — context.view() and one-line Kirewire setup.",
	"version": "0.2.2",
	"main": "dist/cjs/index.cjs",
	"module": "dist/esm/index.js",
	"types": "dist/types/index.d.ts",
	"typings": "dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.cjs"
		}
	},
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/drysius/kire.git"
	},
	"keywords": [
		"elysia",
		"kire",
		"view-engine",
		"ssr",
		"bun",
		"typescript"
	],
	"author": "drysius",
	"license": "MIT",
	"dependencies": {
		"kire": "workspace:../../core"
	},
	"peerDependencies": {
		"@kirejs/wire": "workspace:*",
		"elysia": "^1"
	},
	"peerDependenciesMeta": {
		"@kirejs/wire": {
			"optional": true
		}
	},
	"devDependencies": {
		"@kirejs/wire": "workspace:*"
	}
}
